﻿@model PortfolioProjectNight.Models.Category

@{
    ViewBag.Title = "UpdateCategory";
    Layout = "~/Views/Admin/Index.cshtml";
}

<h2 style="text-align:center">Kategori Güncelleme Sayfası</h2>

<form method="post">


    <label style="visibility:hidden">Kategori ID</label>
    @Html.TextBoxFor(x => x.CategoryId, new { @class = "form-control", @style = "visibility:hidden" })
    <br />

    <label>Kategori İsmi</label>
    @Html.TextBoxFor(x => x.CategoryName, new { @class = "form-control" })
    <br />

    <button class="btn btn-dark">Kategori Bilgilerini Güncelle ve Kaydet</button>

</form>