@{
    ViewBag.Title = "CreateReference";
    Layout = "~/Views/Admin/Index.cshtml";
}


<h2 class="mb-4" style="text-align:center">Yeni Referans Bilgisi Girişi</h2>

<form method="post">
    <label>Başlık</label>
    <input type="text" class="form-control" name="NameSurname" />
    <br />
    <label>Alt Başlık</label>
    <input type="text" class="form-control" name="Title" />
    <br />
    <label>Resim Url</label>
    <textarea rows="5" class="form-control" name="Image"></textarea>
    <br />
    <label>Açıklama</label>
    <textarea rows="5" class="form-control" name="Comment"></textarea>
    <br />
    <button class="btn btn-dark">Kaydet</button>
</form>

