﻿@model PortfolioProjectNight.Models.Service

@{
    ViewBag.Title = "UpdateService";
    Layout = "~/Views/Admin/Index.cshtml";
}

<h2 class="mb-4" style="text-align:center">Hizmet Bilgilerini Güncelleme Sayfası</h2>
<form method="post">
    <label style="display:none">Hizmet ID</label>
    @Html.TextBoxFor(x => x.Serviceld, new { @class = "form-control", @style = "display:none" })
    <br />
    <label>Başlık</label>
    @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
    <br />
    <label>Alt Başlık</label>
    @Html.TextBoxFor(x => x.Description, new { @class = "form-control" })
    <br />
    <label>Açıklama</label>
    @Html.TextBoxFor(x => x.Icon, new { @class = "form-control" })
    <br />
    <button class="btn btn-dark">Güncellenen Bilgileri Kaydet</button>
</form>

